# Local services only. Copy to .env.local, then copy the publishable key
# (or legacy anon key) printed by `npm run db:status` after starting Supabase.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Development rejects remote Supabase URLs. Local production builds may use
# loopback HTTP; future hosted services require HTTPS and a fresh build.
# Never place a service-role / secret key in NEXT_PUBLIC_* variables.
